/-
Private source-shaped semantics of WithdrawalWindowLib at the run's pinned V2 source.
No Solidity changes, generated bytecode, or compiler-refinement claim.

Representation boundary: Solidity's fixed array is a total function of physical
indices, with default-zero cells; the packed 64/192-bit fields are natural-number
projections. Downcasts are MODULO, not additional revert checks. `write` keeps the
source's explicit width, monotonicity, and checked sequence-increment checks.
The binary search is the actual upper-bound search, not an ideal expiry oracle.
Lean's decreasing-measure recursion replaces the while loop without a fuel cutoff.
The separate chronological list in Specs is ghost state ONLY; lookup never reads it.
-/
import Verity.Core.Invariant
import Verity.Core.NarrowTypes
import Std.Tactic

namespace Benchmark.Cases.Kuru.WithdrawalLimit

def width (n : Nat) : Nat := 2 ^ n
def maxWord (n : Nat) : Nat := width n - 1
def castWord (n v : Nat) : Nat := (Verity.Core.UIntN.ofNat n v).val

def window : Nat := 86400
def ringCapacity : Nat := window + 1

inductive Error where
  | history | valueOverflow | arithmetic | unauthorized | config | price
  | limit | paused | reentrant | account | recipient | amount | balance
  | deadline | signature | nonce | frozen | transfer | token | binding
  deriving DecidableEq, Repr

abbrev Checked := Except Error

def ensure (p : Prop) [Decidable p] (e : Error) : Checked Unit :=
  if p then .ok () else .error e

def checkedAdd (bits a b : Nat) : Checked Nat := do
  ensure (a + b < width bits) .arithmetic
  return a + b

def checkedSub (a b : Nat) : Checked Nat := do
  ensure (b ≤ a) .arithmetic
  return a - b

structure Checkpoint where
  timestamp : Nat := 0
  cumulative : Nat := 0
  deriving DecidableEq, Repr

structure History where
  latestSequence : Nat := 0
  referenceSequence : Nat := 0
  checkpoints : Nat → Checkpoint := fun _ => {}

/-- Safe when sequence>0; reflects checked subtraction in `_at`. -/
def checkpointAt (h : History) (sequence : Nat) : Checkpoint :=
  h.checkpoints ((sequence - 1) % ringCapacity)

def current (h : History) : Nat :=
  if h.latestSequence = 0 then 0 else (checkpointAt h h.latestSequence).cumulative

/-- Source `while (low < high)`; no ghost list or supplied expiry answer. -/
def upperBound (h : History) (cutoff low high : Nat) : Nat :=
  if hh : low < high then
    let middle := (low + high) / 2
    if (checkpointAt h (castWord 64 middle)).timestamp ≤ cutoff then
      upperBound h cutoff (middle + 1) high
    else
      upperBound h cutoff low middle
  else low
termination_by high - low
decreasing_by all_goals simp_wf; omega

/-- Preserves every source branch, including the stale-cache validations. -/
def referenceAt (h : History) (now : Nat) : Checked (Nat × Nat) := do
  let latest := h.latestSequence
  if latest = 0 ∨ now < window then return (0, 0)
  let cutoff := now - window
  let checkpoint := checkpointAt h latest
  if checkpoint.timestamp ≤ cutoff then return (checkpoint.cumulative, latest)
  let oldest := if latest > ringCapacity then latest - ringCapacity + 1 else 1
  let checkpoint := checkpointAt h oldest
  if checkpoint.timestamp > cutoff then
    ensure (oldest = 1) .history
    return (0, 0)
  let cached := h.referenceSequence
  if cached ≥ oldest ∧ cached < latest then
    let checkpoint := checkpointAt h cached
    if checkpoint.timestamp ≤ cutoff then
      let next := checkpointAt h (cached + 1)
      if next.timestamp > cutoff then return (checkpoint.cumulative, cached)
      if cached + 1 < latest ∧ (checkpointAt h (cached + 2)).timestamp > cutoff then
        return (next.cumulative, cached + 1)
  let low := upperBound h cutoff oldest (latest + 1)
  let sequence := castWord 64 (low - 1)
  return ((checkpointAt h sequence).cumulative, sequence)

/-- Caller sees `.error` without a committed write. Sequence overflow REVERTS. -/
def write (h : History) (value now : Nat) : Checked History := do
  ensure (value ≤ maxWord 192) .valueOverflow
  ensure (now ≤ maxWord 64) .history
  let sequence ← if h.latestSequence = 0 then pure 1 else do
    let previous := checkpointAt h h.latestSequence
    ensure (value ≥ previous.cumulative) .history
    ensure (now ≥ previous.timestamp) .history
    if now ≠ previous.timestamp then checkedAdd 64 h.latestSequence 1
    else pure h.latestSequence
  let index := (sequence - 1) % ringCapacity
  let cell : Checkpoint := ⟨castWord 64 now, castWord 192 value⟩
  return { h with
    latestSequence := if sequence ≠ h.latestSequence then sequence else h.latestSequence
    checkpoints := fun i => if i = index then cell else h.checkpoints i }

/-- Packed timestamp is the low 64 bits of the Solidity checkpoint cell. -/
def packCheckpoint (c : Checkpoint) : Nat := c.timestamp + c.cumulative * width 64

def unpackCheckpoint (word : Nat) : Checkpoint :=
  ⟨word % width 64, (word / width 64) % width 192⟩

end Benchmark.Cases.Kuru.WithdrawalLimit
